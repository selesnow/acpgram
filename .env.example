# Токен бота от @BotFather (не коммитить настоящее значение!)
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID главного администратора
ALLOWED_USER_ID=
# Корень проектов: папка, внутри которой агент выбирает рабочую папку (/project). Необязательная.
# Задайте на общем (командном) сервере: проектом можно выбрать только папку внутри корня.
# Без неё (личная установка) проектом может быть любая папка на машине, по умолчанию — домашняя папка.
# Windows: PROJECTS_ROOT=C:\scripts
# Linux / macOS: PROJECTS_ROOT=/home/user/projects
PROJECTS_ROOT=
# Личные пространства: 1 — каждый сотрудник выбирает проекты только в своей папке <корень>/<Telegram ID>
# (создаётся сама), чужие папки ему не видны; администратор видит весь корень. Нужен PROJECTS_ROOT.
# Ограничивает выбор папки в боте, но не изолирует сам процесс агента.
# USER_WORKSPACES=1
# Песочница агента (только Linux, нужен пакет bubblewrap): bwrap — агент сотрудника запускается изолированно и видит
# только его папку проектов, его файлы и его домашнюю папку (<каталог данных>/homes/<id>); .env и база бота, чужие папки
# и чужие процессы ему недоступны. Администратор работает без песочницы. На Windows и macOS не задавать.
# AGENT_SANDBOX=bwrap
# Дополнительные папки на чтение в песочнице (через «:»), например место установки движка
# SANDBOX_RO_PATHS=/opt/engines
# Путь к bwrap, если его нет в PATH
# BWRAP_COMMAND=/usr/bin/bwrap

# Ключ Gemini API (https://aistudio.google.com/apikey). Передаётся процессу Gemini через окружение бота.
# Не нужен, если Gemini CLI уже авторизован под учётной записью, от которой запущен бот.
# Процесс агента получает только ключи своего движка (Claude Code — ANTHROPIC_API_KEY, Codex — OPENAI_API_KEY,
# Gemini CLI и Antigravity — ключи Google, OpenCode — все); токен бота агентам не передаётся.
# GEMINI_API_KEY=

# Только для Docker: папка проектов на хосте, которая монтируется в контейнер как /projects.
# PROJECTS_ROOT и команды движков в контейнере задаются автоматически.
# PROJECTS_DIR=/home/user/projects
# Только для Docker: какие движки ставить в образ (через пробел). По умолчанию все: gemini claude codex agy opencode.
# Antigravity CLI: вход один раз (docker compose exec -it bot agy acp --login) или ключ Gemini API (GEMINI_API_KEY и "modelProvider": "gemini" в settings.json Antigravity)
# ENGINES=gemini claude codex agy opencode

# Язык бота: по умолчанию язык Telegram пользователя (ru, uk, en). DEFAULT_LANG — язык для остальных: en | ru | uk.
# Пользователь может сменить язык командой /language.
# DEFAULT_LANG=en
# Язык команд acpgram в терминале берётся из системы; для Docker и CI можно задать явно: ru | uk | en
# ACPGRAM_LANG=

# Необязательные настройки (значения по умолчанию)
# ACP_MODE=autoEdit
# MAX_AGENTS=3
# Режим «диалоги» (темы): сколько агентов одного сотрудника и администратора работает одновременно
# MAX_AGENTS_PER_USER=2
# ADMIN_MAX_AGENTS=4
# IDLE_MINUTES=30
# Сколько секунд ждать запуска агента; дольше — процесс завершается, пользователь получает понятную ошибку
# AGENT_START_TIMEOUT=120
# 1 — подробный журнал того, что бот отправляет в Telegram (data/debug.log, до 5 МБ + один прошлый файл)
# ACPGRAM_DEBUG=0
# Каталог принятых и исходящих файлов (по умолчанию — каталог данных бота) и срок хранения, дней
# FILES_DIR=
# FILES_KEEP_DAYS=7
# 0 — обычные эмодзи вместо анимированных иконок в черновике
# ANIMATED_ICONS=1
# Виджеты для /model и /sessions (Bot API 10.4). По умолчанию выключены: с 13.11.2026 Telegram не разрешает обычным ботам
# отправлять виджеты. 1 — пробовать виджет и показывать обычное меню, если Telegram его не принял
# WIDGETS=1

# Полный путь к Gemini CLI, если его нет в PATH (часто нужно при запуске как служба)
# По умолчанию: gemini.cmd на Windows, gemini на Linux и macOS
# GEMINI_COMMAND=C:\Users\<user>\AppData\Roaming\npm\gemini.cmd
# GEMINI_COMMAND=/usr/local/bin/gemini

# Движок по умолчанию: gemini | claude | agy | codex | opencode (по умолчанию gemini). Без него бот не запускается,
# остальные движки необязательны: недоступные просто не предлагаются в /engine.
# DEFAULT_ENGINE=gemini

# Claude Code через ACP-мост: npm i -g @agentclientprotocol/claude-agent-acp
# Ключ Anthropic API: Claude Code работает и оплачивается по API (без него — по подписке, если Claude Code авторизован)
# ANTHROPIC_API_KEY=
# CLAUDE_COMMAND=claude-agent-acp
# Режим Claude Code для администратора (уровень «Полный» у сотрудников — тоже bypassPermissions)
# CLAUDE_ADMIN_MODE=bypassPermissions

# Antigravity CLI 1.5+, запускается как `agy acp`. Авторизация — вход Google (один раз `agy acp --login`) или ключ Gemini API: GEMINI_API_KEY в окружении и "modelProvider": "gemini" в ~/.gemini/antigravity-cli/settings.json
# AGY_COMMAND=agy
# AGY_ADMIN_MODE=accept-edits

# OpenAI Codex через ACP-мост: npm i -g @agentclientprotocol/codex-acp (нужен Codex CLI: вход `codex login`)
# Ключ OpenAI API: по API (без него — по входу ChatGPT, если Codex авторизован)
# OPENAI_API_KEY=
# CODEX_COMMAND=codex-acp
# Режим Codex для администратора: read-only | workspace-write | agent | agent-full-access
# CODEX_ADMIN_MODE=agent-full-access

# OpenCode: npm i -g opencode-ai, запускается как `opencode acp`. Модели — провайдеров, чьи ключи есть выше
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY) или подключены `opencode auth login`; бесплатные модели
# OpenCode Zen работают без ключа (могут использовать запросы для обучения — секреты туда не отправляйте).
# Права по уровню доступа бот передаёт агенту сам (OPENCODE_CONFIG_CONTENT).
# Ещё провайдеры для OpenCode — каждый ключ добавляет группу моделей в /model (OpenRouter — сотни моделей по одному ключу):
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OPENCODE_COMMAND=opencode
# Режим OpenCode для администратора: plan | build
# OPENCODE_ADMIN_MODE=build
