# Токен бота от @BotFather (не коммитить настоящее значение!)
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID главного администратора
ALLOWED_USER_ID=
# Корень проектов: папка, внутри которой агент выбирает рабочую папку (/project). Необязательная.
# Задайте на общем (командном) сервере: проектом можно выбрать только папку внутри корня.
# Без неё (личная установка) проектом может быть любая папка на машине, по умолчанию — домашняя папка.
# Windows: PROJECTS_ROOT=C:\scripts
# Linux / macOS: PROJECTS_ROOT=/home/user/projects
PROJECTS_ROOT=

# Ключ Gemini API (https://aistudio.google.com/apikey). Передаётся процессу Gemini через окружение бота.
# Не нужен, если Gemini CLI уже авторизован под учётной записью, от которой запущен бот.
# GEMINI_API_KEY=

# Только для Docker: папка проектов на хосте, которая монтируется в контейнер как /projects.
# PROJECTS_ROOT и команды движков в контейнере задаются автоматически.
# PROJECTS_DIR=/home/user/projects
# Только для Docker: какие движки ставить в образ (через пробел). По умолчанию все: gemini claude codex agy.
# Antigravity CLI ключей API не поддерживает: вход один раз — docker compose exec -it bot agy acp --login
# ENGINES=gemini claude codex agy

# Необязательные настройки (значения по умолчанию)
# ACP_MODE=autoEdit
# MAX_AGENTS=3
# IDLE_MINUTES=30
# 0 — обычные эмодзи вместо анимированных иконок в черновике
# ANIMATED_ICONS=1

# Полный путь к Gemini CLI, если его нет в PATH (часто нужно при запуске как служба)
# По умолчанию: gemini.cmd на Windows, gemini на Linux и macOS
# GEMINI_COMMAND=C:\Users\<user>\AppData\Roaming\npm\gemini.cmd
# GEMINI_COMMAND=/usr/local/bin/gemini

# Движок по умолчанию: gemini | claude | agy | codex (по умолчанию gemini). Без него бот не запускается,
# остальные движки необязательны: недоступные просто не предлагаются в /engine.
# DEFAULT_ENGINE=gemini

# Claude Code через ACP-мост: npm i -g @agentclientprotocol/claude-agent-acp
# Ключ Anthropic API: Claude Code работает и оплачивается по API (без него — по подписке, если Claude Code авторизован)
# ANTHROPIC_API_KEY=
# CLAUDE_COMMAND=claude-agent-acp
# Режим Claude Code для администратора (уровень «Полный» у сотрудников — тоже bypassPermissions)
# CLAUDE_ADMIN_MODE=bypassPermissions

# Antigravity CLI 1.5+, запускается как `agy acp`. Авторизация — вход Google: один раз `agy acp --login`
# AGY_COMMAND=agy
# AGY_ADMIN_MODE=accept-edits

# OpenAI Codex через ACP-мост: npm i -g @agentclientprotocol/codex-acp (нужен Codex CLI: вход `codex login`)
# Ключ OpenAI API: по API (без него — по входу ChatGPT, если Codex авторизован)
# OPENAI_API_KEY=
# CODEX_COMMAND=codex-acp
# Режим Codex для администратора: read-only | workspace-write | agent | agent-full-access
# CODEX_ADMIN_MODE=agent-full-access
