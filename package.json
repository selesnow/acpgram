{
  "name": "acpgram",
  "version": "1.12.4",
  "type": "module",
  "description": "Telegram gateway to AI coding agents (Gemini CLI, Claude Code, Antigravity CLI, Codex) over the Agent Client Protocol",
  "license": "MIT",
  "author": "Alexey Seleznev",
  "keywords": [
    "telegram",
    "telegram-bot",
    "agent-client-protocol",
    "acp",
    "gemini-cli",
    "claude-code",
    "antigravity",
    "codex",
    "ai",
    "llm",
    "cli"
  ],
  "homepage": "https://github.com/selesnow/acpgram#readme",
  "bugs": {
    "url": "https://github.com/selesnow/acpgram/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selesnow/acpgram.git"
  },
  "bin": {
    "acpgram": "./src/cli.mjs"
  },
  "files": [
    "src",
    "README*.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.mjs",
    "setup": "node --disable-warning=ExperimentalWarning src/setup.mjs",
    "service:install": "node src/service.mjs install",
    "service:uninstall": "node src/service.mjs uninstall",
    "service:status": "node src/service.mjs status",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  }
}
